upstream django_core_backend {
    {{ range service "core-api" }}
    server {{ .Address }}:{{ .Port }} max_fails=3 fail_timeout=10s;
    {{ else }}
    server core-api:8000 max_fails=3 fail_timeout=10s;
    {{ end }}
}

upstream django_market_backend {
    {{ range service "market-api" }}
    server {{ .Address }}:{{ .Port }} max_fails=3 fail_timeout=10s;
    {{ else }}
    server market-api:8002 max_fails=3 fail_timeout=10s;
    {{ end }}
}

upstream django_product_backend {
    {{ range service "product-api" }}
    server {{ .Address }}:{{ .Port }} max_fails=3 fail_timeout=10s;
    {{ else }}
    server product-api:8004 max_fails=3 fail_timeout=10s;
    {{ end }}
}

server {
    listen 80;
    
    client_max_body_size 20M;

    location /static/ {
        alias /var/www/django/static/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /var/www/django/media/;
        expires 30d;
        access_log off;
    }

    location /core-api/ {
        proxy_pass http://django_core_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-Ip $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /market-api/ {
        proxy_pass http://django_market_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-Ip $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /product-api/ {
        proxy_pass http://django_product_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-Ip $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /docs/ {
        alias /etc/nginx/docs/;
    }

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $web_upstream http://market_track_web:8010;
        proxy_pass $web_upstream;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-Ip $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}